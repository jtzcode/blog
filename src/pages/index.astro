---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SECTIONS, SITE } from "@/config";
import { getRelativeUrl } from "@/utils/getRelativeUrl";

const softwareEngineering = SECTIONS.find(
  ({ code }) => code === "software-engineering"
)!;
const aiResearch = SECTIONS.find(({ code }) => code === "ai-research")!;
const softwareEngineeringUrl = getRelativeUrl(softwareEngineering.href);
const aiResearchUrl = getRelativeUrl(aiResearch.href);
const postsUrl = getRelativeUrl("/posts/");
const searchUrl = getRelativeUrl("/search/");
---

<Layout title={`${SITE.title} | 首页`} description={SITE.desc}>
  <Header />
  <main id="main-content" class="app-layout py-16 sm:py-24">
    <h1 class="text-4xl font-bold sm:text-5xl">{SITE.title}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 opacity-90">{SITE.desc}</p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <a
        href={softwareEngineeringUrl}
        class="rounded-xl border border-border p-6 transition hover:border-accent hover:bg-muted/40"
      >
        <h2 class="text-2xl font-semibold text-accent">
          {softwareEngineering.label}
        </h2>
        <p class="mt-2 opacity-80">{softwareEngineering.description}</p>
      </a>
      <a
        href={aiResearchUrl}
        class="rounded-xl border border-border p-6 transition hover:border-accent hover:bg-muted/40"
      >
        <h2 class="text-2xl font-semibold text-accent">{aiResearch.label}</h2>
        <p class="mt-2 opacity-80">{aiResearch.description}</p>
      </a>
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      <LinkButton href={postsUrl}>浏览全部文章</LinkButton>
      <LinkButton href={searchUrl}>搜索博客</LinkButton>
    </div>
  </main>
  <Footer />
</Layout>
